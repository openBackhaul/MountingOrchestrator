@startuml 001_RequestingMediator
skinparam responseMessageBelowArrow true

title
RequestForMountingDeviceCausesRequestingMediatorInstance
end title

participant "APTP" as APTP
participant "MO://v1/mount-device" as MO
participant "MM://v1/provide-netconf-interface" as MM 


APTP -> MO: {deviceType, manufacturerName, deviceIp, mountName} (apiKeyAuth)

MO -> MM: {mountName, deviceKindName, deviceIpAddress} (apiKeyAuth)

MM --> MO: 200: {mediatorInstanceIpAddress, mediatorInstanceNetconfPort}

deactivate MO

@enduml