@startuml 020_ReqiestingMediator
skinparam responseMessageBelowArrow true

title
RequestForMountingDeviceCausesRequestingMediator
end title

participant "APTP" as APTP
participant "MO://v1/mount-device" as MO
participant "MM://v1/provide-mediator-for-this-device" as MM 


APTP -> MO: {deviceType, manufacturerName, deviceIp, mountName} (apiKeyAuth)

MO -> MM: {deviceName, deviceKindName, deviceIpAddress} (apiKeyAuth)

MM --> MO: {deviceName, deviceKindName, deviceIpAddress,\nmediatorInstanceIpAddress, mediatorInstanceNetconfPort}

deactivate MO

@enduml